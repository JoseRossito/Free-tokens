ANTHROPIC_API_KEY=sk-ant-your-key-here
FREE_TOKENS_MODEL=claude-sonnet-4-6
FREE_TOKENS_CACHE_DIR=/tmp/free_tokens_cache
FREE_TOKENS_CACHE_TTL=3600

# HTTP server authentication (required when running the server)
# Generate a strong random token: python -c "import secrets; print(secrets.token_hex(32))"
FREE_TOKENS_API_TOKEN=change-me-to-a-strong-random-token

# Allowed CORS origins for the HTTP server (comma-separated).
# Leave empty to disable cross-origin access entirely.
# Example: FREE_TOKENS_CORS_ORIGINS=https://myapp.com,https://staging.myapp.com
FREE_TOKENS_CORS_ORIGINS=
